# Modèle du fichier .env : copiez ce fichier en ".env" puis remplissez les valeurs
# (ce fichier-ci ne contient aucun secret et peut aller sur GitHub)

# URL du projet Supabase (Project Settings → Data API)
SUPABASE_URL=

# Clé service_role (Project Settings → API Keys → Legacy API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=
